/api/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  Netlify-CDN-Cache-Control: public, s-maxage=3600, stale-while-revalidate=86400
